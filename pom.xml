<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 4.1.x: current supported line (OSS support through 2027-07-31). See ADR-0001. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>org.genealogyarchive</groupId>
    <artifactId>genealogy-archive</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Genealogy Archive System</name>
    <description>Lightweight durable genealogy archive - single deployable modular monolith (Windows and Linux hosts).</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Fixed timestamp for reproducible jar contents. -->
        <project.build.outputTimestamp>2026-10-28T00:00:00Z</project.build.outputTimestamp>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <dependencies>
        <!-- Browser entry point (server-rendered HTML) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Health / readiness endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Plain SQL data access: JdbcClient + HikariCP. No ORM (ADR-0001). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Versioned sequential migrations, invoked explicitly by the 'migrate' command (ADR-0005). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Installation configuration file parsing (safe constructor only). -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>genealogy-archive</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.genealogyarchive.GenealogyArchive</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Fast Development Suite: unit tests, no database (mvnw test). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!-- Phase-Gate Suite: PostgreSQL integration tests (mvnw verify). Requires GAS_TEST_DB_* variables. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Guard rails: toolchain versions and prohibited v1 infrastructure (BUILD-SPEC s.60, NF-001). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-foundation-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <message>Prohibited v1 infrastructure or ORM dependency (see BUILD-SPEC s.60 and ADR-0001).</message>
                                    <excludes>
                                        <exclude>org.hibernate*</exclude>
                                        <exclude>jakarta.persistence</exclude>
                                        <exclude>org.springframework.data:spring-data-jpa</exclude>
                                        <exclude>org.springframework.data:spring-data-redis</exclude>
                                        <exclude>org.springframework.data:spring-data-elasticsearch</exclude>
                                        <exclude>org.springframework.kafka</exclude>
                                        <exclude>org.springframework.amqp</exclude>
                                        <exclude>org.apache.kafka</exclude>
                                        <exclude>com.rabbitmq</exclude>
                                        <exclude>redis.clients</exclude>
                                        <exclude>io.lettuce</exclude>
                                        <exclude>org.elasticsearch*</exclude>
                                        <exclude>org.opensearch*</exclude>
                                        <exclude>software.amazon.awssdk</exclude>
                                        <exclude>com.amazonaws</exclude>
                                        <exclude>com.azure</exclude>
                                        <exclude>com.google.cloud</exclude>
                                        <exclude>org.testcontainers</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
