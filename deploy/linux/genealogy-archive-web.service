# Genealogy Archive System - web application (systemd).
# Installed by deploy/linux/install.sh, which replaces @JAVA@ and @APP_DIR@.
[Unit]
Description=Genealogy Archive System - web application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=genealogy-archive
Group=genealogy-archive
Environment=GAS_CONFIG=/etc/genealogy-archive/installation.yml
ExecStart=@JAVA@ -jar @APP_DIR@/genealogy-archive.jar serve
# 143 = terminated by SIGTERM after a graceful Spring shutdown.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
# Phase 2 (requirement 5, ADR-0010): the web service never writes archival Storage Volumes. The whole
# file system is read-only to it except the staging area (uploads) and its logs. If you change
# files.stagingDirectory or logging.directory, change ReadWritePaths with a drop-in to match.
ProtectSystem=strict
ReadWritePaths=/var/lib/genealogy-archive/staging /var/log/genealogy-archive
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
